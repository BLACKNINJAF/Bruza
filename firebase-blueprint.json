{
  "entities": {
    "Board": {
      "title": "Board",
      "description": "A task board or workspace for categorizing tasks",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the board"
        },
        "userId": {
          "type": "string",
          "description": "UID of the owner"
        },
        "title": {
          "type": "string",
          "description": "Title of the board"
        },
        "description": {
          "type": "string",
          "description": "Description of the board"
        },
        "color": {
          "type": "string",
          "description": "Hex color code representing the board"
        },
        "icon": {
          "type": "string",
          "description": "Icon key for the board"
        },
        "columns": {
          "type": "array",
          "description": "List of status columns in this board"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the board was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the board was last updated"
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A manageable task item with status, priority, and drag-and-drop order",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the task"
        },
        "userId": {
          "type": "string",
          "description": "UID of the task creator and owner"
        },
        "boardId": {
          "type": "string",
          "description": "ID of the board this task belongs to"
        },
        "title": {
          "type": "string",
          "description": "Title of the task"
        },
        "description": {
          "type": "string",
          "description": "Detailed notes or description"
        },
        "status": {
          "type": "string",
          "description": "Current status column: todo, in_progress, review, or done"
        },
        "priority": {
          "type": "string",
          "description": "Priority level: low, medium, high, or urgent"
        },
        "order": {
          "type": "integer",
          "description": "Integer order position for drag-and-drop sorting"
        },
        "dueDate": {
          "type": "string",
          "format": "date-time",
          "description": "Optional due date timestamp"
        },
        "tags": {
          "type": "array",
          "description": "List of category tags"
        },
        "isCompleted": {
          "type": "boolean",
          "description": "Whether the task is marked completed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["id", "userId", "boardId", "title", "status", "priority", "order", "isCompleted", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/boards/{boardId}": {
      "schema": "Board",
      "description": "User boards collection"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks collection"
    }
  }
}
